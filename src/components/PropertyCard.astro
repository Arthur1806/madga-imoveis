---
import { Image } from 'astro:assets';
import { PURPOSE_LABEL, TYPE_LABEL, formatPrice, getPhotos, specs, type Imovel } from '../lib/imoveis';
import { u } from '../lib/url';
import Icon from './Icon.astro';
import CarouselScript from './CarouselScript.astro';
interface Props { imovel: Imovel; eager?: boolean }
const { imovel, eager = false } = Astro.props;
const photos = getPhotos(imovel).slice(0, 5);
const s = specs(imovel);
---
<li
  class="card"
  data-purpose={imovel.purpose}
  data-type={imovel.type}
  data-neighborhood={imovel.neighborhood}
  data-price={imovel.price ?? 0}
  data-bedrooms={imovel.bedrooms ?? 0}
>
  <div class="card__media" data-carousel>
    {photos.length > 0 ? (
      <div class="card__track" data-track>
        {photos.map((p, i) => (
          <Image src={p} alt={i === 0 ? `${TYPE_LABEL[imovel.type]} em ${imovel.neighborhood}, Brasília: ${imovel.title}` : `${imovel.title} - foto ${i + 1}`} widths={[400, 640, 900]} sizes="(min-width: 960px) 380px, (min-width: 640px) 45vw, 92vw" loading={eager && i === 0 ? 'eager' : 'lazy'} />
        ))}
      </div>
    ) : (
      <div class="placeholder">Foto em breve</div>
    )}
    {photos.length > 1 && (
      <>
        <button class="car__arrow car__arrow--prev" type="button" data-dir="-1" aria-label="Foto anterior"><Icon name="arrow" /></button>
        <button class="car__arrow car__arrow--next" type="button" data-dir="1" aria-label="Próxima foto"><Icon name="arrow" /></button>
        <span class="car__count" data-count>1 / {photos.length}</span>
      </>
    )}
    <span class="card__tag">{PURPOSE_LABEL[imovel.purpose]} · {TYPE_LABEL[imovel.type]}</span>
  </div>
  <div class="card__body">
    <span class="card__loc">{imovel.neighborhood}</span>
    <h3 class="card__title"><a class="stretch" href={u(`/imoveis/${imovel.slug}`)}>{imovel.title}</a></h3>
    {s.length > 0 && (
      <div class="specs">{s.map((i) => <span><strong>{i.value}</strong> {i.label.toLowerCase()}</span>)}</div>
    )}
    <div class="card__foot">
      <p class="card__price">{formatPrice(imovel)}</p>
      <span class="card__cta">Ver imóvel</span>
    </div>
  </div>
</li>
<CarouselScript />
