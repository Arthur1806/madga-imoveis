---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE, whatsappUrl } from '../config/site';
import { agentSchema, breadcrumbs } from '../lib/schema';
const a = SITE.address;
---
<Base
  title="Contato | Fale com a Magda Imóveis"
  description="Fale com a Magda Imóveis pelo WhatsApp (61) 9 9903-6449, telefone (61) 3771-7661 ou formulário. Atendimento no Lago Sul, Brasília-DF."
  jsonLd={[agentSchema, breadcrumbs([{ name: 'Início', path: '/' }, { name: 'Contato', path: '/contato' }])]}
>
  <section class="phero">
    <div class="wrap">
      <ol class="crumbs" aria-label="Você está em"><li><a href="/">Início</a></li><li aria-current="page">Contato</li></ol>
      <span class="eyebrow">Contato</span>
      <h1>Fale com um especialista</h1>
      <p class="lead">{SITE.responseTime}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap contact">
      <div>
        <a class="btn btn--wa btn--block" style="min-height:3.6rem;font-size:1.05rem" href={whatsappUrl('Olá! Vim pelo site da Magda Imóveis e gostaria de atendimento.')} target="_blank" rel="noopener"><Icon name="whatsapp" /> Chamar no WhatsApp</a>
        <div class="channels" style="margin-top:1.5rem">
          <a class="channel" href={SITE.phone.href}><Icon name="phone" /><div><small>Telefone</small><span>{SITE.phone.display}</span></div></a>
          <a class="channel" href={`mailto:${SITE.email}`}><Icon name="mail" /><div><small>E-mail</small><span>{SITE.email}</span></div></a>
          <a class="channel" href={SITE.instagram.url} target="_blank" rel="noopener"><Icon name="instagram" /><div><small>Instagram</small><span>{SITE.instagram.handle}</span></div></a>
          <a class="channel" href={a.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" /><div><small>Endereço</small><span>{a.street} — {a.neighborhood}, {a.city}-{a.state}, CEP {a.postalCode}</span></div></a>
        </div>
        <h2 style="font-size:1.6rem;margin:2.5rem 0 1rem">Horário de atendimento</h2>
        <dl class="hours">
          {SITE.hours.map((h) => <div><dt>{h.days}</dt><dd>{h.time}</dd></div>)}
        </dl>
        <a class="btn btn--ghost" style="margin-top:1.5rem" href={a.mapsUrl} target="_blank" rel="noopener"><Icon name="pin" /> Abrir no Google Maps</a>
      </div>
      <div>
        <h2 style="font-size:clamp(1.7rem,4vw,2.2rem);margin-bottom:1rem">Envie uma mensagem</h2>
        <ContactForm idPrefix="ct" />
      </div>
    </div>
  </section>
</Base>
