---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE, whatsappUrl } from '../config/site';
import { agentSchema, breadcrumbs } from '../lib/schema';
const a = SITE.address;
---
<Base
  title="Contato | Fale com a Magda Imóveis"
  description="Fale com a Magda Imóveis pelo WhatsApp (61) 9 9903-6449, telefone (61) 3771-7661 ou formulário. Atendimento no Lago Sul, Brasília-DF."
  jsonLd={[agentSchema, breadcrumbs([{ name: 'Início', path: '/' }, { name: 'Contato', path: '/contato' }])]}
>
  <section class="shero chero">
    <div class="wrap shero__in">
      <span class="eyebrow">Contato</span>
      <h1>Fale com <em>um especialista</em></h1>
      <p class="lead">{SITE.responseTime}</p>
    </div>
  </section>

  <section class="section chero__body">
    <div class="wrap">
      <div class="quick">
        <a class="quick__item quick__item--wa" href={whatsappUrl('Olá! Vim pelo site da Magda Imóveis e gostaria de atendimento.')} target="_blank" rel="noopener">
          <span class="quick__icon"><Icon name="whatsapp" /></span>
          <span class="quick__txt"><small>Resposta mais rápida</small><strong>WhatsApp</strong></span>
          <Icon name="arrow" />
        </a>
        <a class="quick__item" href={SITE.phone.href}>
          <span class="quick__icon"><Icon name="phone" /></span>
          <span class="quick__txt"><small>Telefone</small><strong>{SITE.phone.display}</strong></span>
          <Icon name="arrow" />
        </a>
        <a class="quick__item" href={`mailto:${SITE.email}`}>
          <span class="quick__icon"><Icon name="mail" /></span>
          <span class="quick__txt"><small>E-mail</small><strong>{SITE.email}</strong></span>
          <Icon name="arrow" />
        </a>
        <a class="quick__item" href={SITE.instagram.url} target="_blank" rel="noopener">
          <span class="quick__icon"><Icon name="instagram" /></span>
          <span class="quick__txt"><small>Instagram</small><strong>{SITE.instagram.handle}</strong></span>
          <Icon name="arrow" />
        </a>
      </div>

      <div class="contact contact--modern">
        <div class="contact__form">
          <span class="eyebrow">Mensagem</span>
          <h2>Envie uma mensagem</h2>
          <p class="contact__sub">Conte o que você procura e retornamos o mais breve possível.</p>
          <ContactForm idPrefix="ct" />
        </div>
        <aside class="contact__info">
          <div class="infocard">
            <span class="infocard__icon"><Icon name="pin" /></span>
            <h3>Nosso escritório</h3>
            <p>{a.street} — {a.neighborhood}, {a.city}-{a.state}, CEP {a.postalCode}</p>
            <a class="svc__link" href={a.mapsUrl} target="_blank" rel="noopener">Abrir no Google Maps <Icon name="arrow" /></a>
          </div>
          <div class="infocard">
            <span class="infocard__icon"><Icon name="clock" /></span>
            <h3>Horário de atendimento</h3>
            <dl class="hours">
              {SITE.hours.map((h) => <div><dt>{h.days}</dt><dd>{h.time}</dd></div>)}
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>
