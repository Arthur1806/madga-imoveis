---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import { getImoveis, TYPE_LABEL } from '../../lib/imoveis';
import { breadcrumbs } from '../../lib/schema';
import { whatsappUrl } from '../../config/site';

const all = getImoveis();
const neighborhoods = [...new Set(all.map((i) => i.neighborhood))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
const types = [...new Set(all.map((i) => i.type))];
---
<Base
  title="Imóveis à venda e para alugar em Brasília"
  description="Casas, apartamentos e imóveis comerciais de alto padrão à venda e para locação em Brasília-DF: Lago Sul, Park Way, Jardim Botânico, Asa Sul e mais."
  jsonLd={breadcrumbs([{ name: 'Início', path: '/' }, { name: 'Imóveis', path: '/imoveis' }])}
>
  <section class="phero">
    <div class="wrap">
      <span class="eyebrow">Nosso portfólio</span>
      <h1>Imóveis em Brasília</h1>
      <p class="lead">Casas e apartamentos de alto padrão selecionados pela equipe da Magda Imóveis.</p>
    </div>
  </section>

  <section class="section" style="padding-top: clamp(2rem,5vw,3.5rem)">
    <div class="wrap listing">
      <form class="filters" id="filters" aria-label="Filtrar imóveis" onsubmit="return false">
        <button class="btn btn--ghost filters__toggle" type="button" aria-expanded="false" aria-controls="filters-panel"><Icon name="filter" /> Filtrar e ordenar</button>
        <div class="filters__panel" id="filters-panel">
          <div class="field">
            <span class="label">Finalidade</span>
            <div class="chips" role="group" aria-label="Finalidade">
              <button type="button" class="chip" data-purpose="" aria-pressed="true">Todos</button>
              <button type="button" class="chip" data-purpose="venda" aria-pressed="false">Comprar</button>
              <button type="button" class="chip" data-purpose="aluguel" aria-pressed="false">Alugar</button>
            </div>
          </div>
          <div class="field">
            <label for="f-tipo">Tipo</label>
            <select class="select" id="f-tipo" name="tipo">
              <option value="">Todos</option>
              {types.map((t) => <option value={t}>{TYPE_LABEL[t]}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-bairro">Região</label>
            <select class="select" id="f-bairro" name="bairro">
              <option value="">Todas</option>
              {neighborhoods.map((n) => <option value={n}>{n}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="f-ordem">Ordenar por</label>
            <select class="select" id="f-ordem" name="ordem">
              <option value="">Destaques</option>
              <option value="menor">Menor valor</option>
              <option value="maior">Maior valor</option>
            </select>
          </div>
          <button type="button" class="btn btn--ghost" id="f-clear">Limpar filtros</button>
        </div>
      </form>

      <div>
        <div class="results-meta" style="margin-bottom:1.5rem">
          <span id="count" aria-live="polite">{all.length} imóveis</span>
        </div>
        <ul class="grid grid--3" id="list">
          {all.map((i, idx) => <PropertyCard imovel={i} eager={idx < 2} />)}
        </ul>
        <div class="empty" id="empty" hidden>
          <p><strong>Nenhum imóvel encontrado com esses filtros.</strong></p>
          <p>Fale com a nossa equipe: podemos indicar opções que ainda não estão no site.</p>
          <a class="btn btn--wa" href={whatsappUrl('Olá! Não encontrei o imóvel que procuro no site. Podem me ajudar?')} target="_blank" rel="noopener"><Icon name="whatsapp" /> Falar no WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const list = document.getElementById('list') as HTMLUListElement;
  const cards = Array.from(list.children) as HTMLElement[];
  const original = [...cards];
  const empty = document.getElementById('empty')!;
  const count = document.getElementById('count')!;
  const tipo = document.getElementById('f-tipo') as HTMLSelectElement;
  const bairro = document.getElementById('f-bairro') as HTMLSelectElement;
  const ordem = document.getElementById('f-ordem') as HTMLSelectElement;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-purpose]'));
  const panel = document.getElementById('filters-panel')!;
  const toggle = document.querySelector<HTMLButtonElement>('.filters__toggle')!;
  let purpose = '';

  const setPurpose = (v: string) => {
    purpose = v;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.purpose === v)));
  };

  const apply = (updateUrl = true) => {
    let visible = 0;
    cards.forEach((c) => {
      const ok =
        (!purpose || c.dataset.purpose === purpose) &&
        (!tipo.value || c.dataset.type === tipo.value) &&
        (!bairro.value || c.dataset.neighborhood === bairro.value);
      c.hidden = !ok;
      if (ok) visible++;
    });
    const sorted = ordem.value
      ? [...original].sort((a, b) => {
          const d = Number(a.dataset.price) - Number(b.dataset.price);
          return ordem.value === 'menor' ? d : -d;
        })
      : original;
    sorted.forEach((c) => list.appendChild(c));
    count.textContent = `${visible} ${visible === 1 ? 'imóvel' : 'imóveis'}`;
    empty.hidden = visible > 0;
    list.hidden = visible === 0;
    if (updateUrl) {
      const p = new URLSearchParams();
      if (purpose) p.set('finalidade', purpose);
      if (tipo.value) p.set('tipo', tipo.value);
      if (bairro.value) p.set('bairro', bairro.value);
      if (ordem.value) p.set('ordem', ordem.value);
      const qs = p.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }
  };

  const params = new URLSearchParams(location.search);
  const legacy = params.get('type');
  setPurpose(params.get('finalidade') ?? (legacy === 'venda' || legacy === 'aluguel' ? legacy : ''));
  tipo.value = params.get('tipo') ?? '';
  bairro.value = params.get('bairro') ?? '';
  ordem.value = params.get('ordem') ?? '';
  apply(false);

  chips.forEach((c) => c.addEventListener('click', () => { setPurpose(c.dataset.purpose ?? ''); apply(); }));
  [tipo, bairro, ordem].forEach((el) => el.addEventListener('change', () => apply()));
  document.getElementById('f-clear')!.addEventListener('click', () => {
    setPurpose(''); tipo.value = ''; bairro.value = ''; ordem.value = ''; apply();
  });
  toggle.addEventListener('click', () => {
    const open = panel.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
